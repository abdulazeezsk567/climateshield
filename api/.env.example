# ClimateShield API Gateway Service Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# CORS Settings (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication & Security Placeholders
JWT_SECRET_KEY=development-insecure-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEMO_READ_ONLY_MODE=false

# Downstream Service URLs (if routed over HTTP)
LMS_WEBHOOK_ENDPOINT_URL=http://localhost:8001/api/v1/webhook
