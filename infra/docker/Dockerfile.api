# ==============================================================================
# ClimateShield API Gateway Containerfile
# Hardened, unprivileged Python 3.11 container orchestrating all backend layers.
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SERVICE_NAME=climateshield-api

WORKDIR /app

# Install curl for container health probes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install shared foundational package first for layer caching
COPY packages/shared/python /app/packages/shared/python
RUN pip install -e /app/packages/shared/python

# Install dependent backend layers
COPY data-layer /app/data-layer
RUN pip install -e /app/data-layer

COPY risk-engine /app/risk-engine
RUN pip install -e /app/risk-engine

COPY integration-layer /app/integration-layer
RUN pip install -e /app/integration-layer

# Install API gateway application
COPY api /app/api
RUN pip install -e /app/api

# Create runtime directory for data and logs
RUN mkdir -p /app/data && chmod -R 777 /app/data

# Security: run as unprivileged user
RUN useradd -u 10001 -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Continuous container healthcheck probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
