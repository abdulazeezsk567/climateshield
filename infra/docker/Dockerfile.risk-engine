# ==============================================================================
# ClimateShield Risk Engine Daemon Containerfile
# Background worker for ML zoning evaluation, threshold triggers, and basis-risk audits.
# ==============================================================================

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    SERVICE_NAME=climateshield-risk-engine

WORKDIR /app

COPY packages/shared/python /app/packages/shared/python
RUN pip install -e /app/packages/shared/python

COPY data-layer /app/data-layer
RUN pip install -e /app/data-layer

COPY risk-engine /app/risk-engine
RUN pip install -e /app/risk-engine

RUN useradd -u 10001 -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app
USER appuser

CMD ["python", "-m", "risk_engine"]
